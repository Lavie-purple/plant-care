{
  "name": "personal-plant-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first 个人植物管理与养护助手。植物 + 历史 + 天气 → 浇水建议。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "test:watch": "node --test --watch --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "verify": "npm run build && node --test --test-concurrency=1 \"dist/tests/**/*.test.js\" && echo \"VERDICT: ALL GREEN\""
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0"
  }
}
